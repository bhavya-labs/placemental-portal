# =============================================================================
# AP-CPIP Example Environment Configuration (.env.example)
# Copy this file to .env and configure appropriate values before deployment
# =============================================================================

PROJECT_NAME="AI-Powered Placement Intelligence Platform"

# Generate a strong 64-character hex secret for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
DATABASE_URL=sqlite:///./placement_portal.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/placement_portal

# CORS Allowed Origins (comma-separated list of trusted client origins)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://bhavya-labs.github.io

# Auth Login Rate Limiting
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Parent Portal OTP & SMS Rate Limiting
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_HOURS=1
OTP_MAX_VERIFY_ATTEMPTS=3
SMS_ENV=dev
